Subject: Add support/xm{,un}map.c

---
 support/Makefile  |  2 ++
 support/xmmap.c   | 31 +++++++++++++++++++++++++++++++
 support/xmunmap.c | 28 ++++++++++++++++++++++++++++
 3 files changed, 61 insertions(+)
 create mode 100644 support/xmmap.c
 create mode 100644 support/xmunmap.c

diff --git a/support/Makefile b/support/Makefile
index 65f83f0a7f..46c4814a49 100644
--- a/support/Makefile
+++ b/support/Makefile
@@ -43,6 +43,8 @@ libsupport-routines = \
   xgetsockname \
   xlisten \
   xmalloc \
+  xmmap \
+  xmunmap \
   xpoll \
   xpthread_check_return \
   xpthread_create \
diff --git a/support/xmmap.c b/support/xmmap.c
new file mode 100644
index 0000000000..435b1eb733
--- /dev/null
+++ b/support/xmmap.c
@@ -0,0 +1,31 @@
+/* mmap with error checking.
+   Copyright (C) 2016-2017 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
